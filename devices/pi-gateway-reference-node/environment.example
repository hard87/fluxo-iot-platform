FLUXO_MQTT_HOST=<broker-hostname-or-ip>
FLUXO_MQTT_PORT=8883
FLUXO_MQTT_USERNAME=<generated-device-username>
FLUXO_MQTT_PASSWORD=<generated-device-password>
FLUXO_MQTT_CA_PATH=/home/junior/.node-red/ca.crt
FLUXO_TENANT_ID=<tenant-id>
FLUXO_WORKSPACE_ID=<workspace-uuid>
