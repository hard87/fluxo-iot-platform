  {
    "id": "f5a0000000000020",
    "type": "function",
    "z": "f5a0000000000001",
    "name": "Preparar MQTT QoS 1",
    "func": "let record;\ntry { record = JSON.parse(String(msg.payload).trim()); } catch (error) { flow.set('publishInFlight', false); node.error('spool next inválido: ' + error.message, msg); return null; }\nif (record.empty) { flow.set('publishInFlight', false); node.status({fill:'green',shape:'ring',text:'fila vazia'}); return null; }\nmsg.spoolId = record.id;\nmsg.sequence = record.sequence;\nmsg.topic = record.topic;\nmsg.payload = JSON.stringify(record.payload);\nmsg.qos = 1;\nmsg.retain = false;\nnode.status({fill:'blue',shape:'dot',text:'seq ' + record.sequence + ' / fila ' + record.queueDepth});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1140,
    "y": 300,
    "wires": [["f5a0000000000021"]]
  },
