  {
    "id": "f5a0000000000015",
    "type": "function",
    "z": "f5a0000000000001",
    "name": "Atualizar conexão",
    "func": "const text = String(msg.status && msg.status.text || '').toLowerCase();\nconst connected = text === 'connected';\nflow.set('mqttConnected', connected);\nif (!connected) { flow.set('publishInFlight', false); node.status({fill:'red',shape:'ring',text:text || 'offline'}); return null; }\nnode.status({fill:'green',shape:'dot',text:'connected'});\nmsg.payload = 'reconnect';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "flow.set('mqttConnected', false); flow.set('publishInFlight', false);",
    "finalize": "",
