FLUXO_DB_NAME=fluxo_db
FLUXO_DB_USER=fluxo
FLUXO_DB_PASSWORD=fluxo
FLUXO_DB_PUBLIC_BIND=127.0.0.1
FLUXO_DB_PUBLIC_PORT=5432

FLUXO_MQTT_PUBLIC_BIND=127.0.0.1
FLUXO_MQTT_PUBLIC_PORT=1883
FLUXO_MQTT_TLS_PUBLIC_BIND=127.0.0.1
FLUXO_MQTT_TLS_PUBLIC_PORT=8883
FLUXO_MQTT_TLS_TARGET_HOST=broker.fluxo.local
FLUXO_MQTT_TLS_CA_CERTIFICATE_PATH=
FLUXO_MQTT_TLS_ALLOW_UNTRUSTED=false
FLUXO_MQTT_TLS_IGNORE_CHAIN_ERRORS=false
FLUXO_MQTT_TLS_IGNORE_REVOCATION_ERRORS=false

FLUXO_API_PUBLIC_BIND=127.0.0.1
FLUXO_API_PUBLIC_PORT=5000
FLUXO_PORTAL_PUBLIC_BIND=127.0.0.1
FLUXO_PORTAL_PUBLIC_PORT=8080
FLUXO_PORTAL_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=http://localhost:5000

FLUXO_AUTH_ENABLED=false
FLUXO_AUTH_AUDIENCE=fluxo-api
FLUXO_AUTH_ISSUER=fluxo-local
FLUXO_AUTH_SIGNING_KEY=replace-with-a-strong-jwt-signing-key-at-least-32-chars
FLUXO_AUTH_EXPIRES_MINUTES=60
FLUXO_AUTH_REQUIRE_HTTPS_METADATA=false

FLUXO_DEVICE_OFFLINE_AFTER_SECONDS=120

FLUXO_MQTT_INGESTION_USERNAME=ingestion-worker-local
FLUXO_MQTT_INGESTION_PASSWORD=change-this-local-ingestion-password
FLUXO_MQTT_INGESTION_PORT=1883
FLUXO_MQTT_INGESTION_USE_TLS=false
